{
    "name": "nadar/yii2-sentry",
    "description": "Yii2 Sentry integration with log target support",
    "type": "yii2-extension",
    "keywords": ["yii2", "sentry", "logging", "error tracking"],
    "license": "MIT",
    "authors": [
        {
            "name": "Basil Suter",
            "email": "git@nadar.io"
        }
    ],
    
    "scripts": {
        "test": [
            "docker run --rm -it -u \"$(id -u):$(id -g)\" -v \"$PWD:/app\" -w /app php:8.4-cli bash -lc 'set -e; if ! command -v composer >/dev/null 2>&1; then curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin --filename=composer; fi; composer install --no-interaction --prefer-dist; ./vendor/bin/phpunit $*' --"
        ],
        "phpstan": [
            "phpstan analyse"
        ]
    },
    "require": {
        "php": "^8.4|^8.5",
        "sentry/sentry": "^4.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "yiisoft/yii2": "^2.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "platform": {
            "php" : "8.5"
        },
        "allow-plugins": {
            "yiisoft/yii2-composer": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Nadar\\Sentry\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nadar\\Sentry\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        }
    },
    "repositories": [
        {
          "type": "composer",
          "url": "https://asset-packagist.org"
        }
    ]

}
